<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="nAccent">@color/accent</item>
        <item name="nAccent2">@color/accent2</item>
        <item name="nAccentSoft">@color/accent_soft</item>
        <item name="nBg">@color/bg</item>
        <item name="nSurface">@color/surface</item>
        <item name="nSurface2">@color/surface2</item>
        <item name="nCardStroke">@color/card_stroke</item>
        <item name="nDivider">@color/divider</item>
        <item name="android:colorPrimary">?attr/nAccent</item>
        <item name="android:colorPrimaryDark">?attr/nBg</item>
        <item name="android:colorAccent">?attr/nAccent</item>
        <item name="android:colorControlActivated">?attr/nAccent</item>
        <item name="android:colorControlHighlight">#1F7A7F99</item>
        <item name="android:windowBackground">?attr/nBg</item>
        <item name="android:colorBackground">?attr/nBg</item>
        <item name="android:statusBarColor">?attr/nBg</item>
        <item name="android:navigationBarColor">?attr/nBg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textColorHighlight">#557A6CF7</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">@drawable/bg_action_mode</item>
        <item name="android:actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="android:windowAnimationStyle">@style/ScreenAnim</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="DialogTheme" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">?attr/nAccent</item>
        <item name="android:colorControlActivated">?attr/nAccent</item>
        <item name="android:colorBackground">?attr/nSurface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@style/PopAnim</item>
    </style>

    <style name="ScreenAnim" parent="@android:style/Animation.Activity" />
    <style name="PopAnim">
        <item name="android:windowEnterAnimation">@anim/pop_in</item>
        <item name="android:windowExitAnimation">@anim/pop_out</item>
    </style>
    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- round icon button with a soft filled circle -->
    <style name="IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:background">@drawable/bg_round_ripple</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/text</item>
    </style>
    <style name="CircleButton" parent="IconButton">
        <item name="android:background">@drawable/bg_circle</item>
    </style>

    <!-- settings -->
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="SettingsTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="SettingsSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">@color/text2</item>
    </style>
    <style name="SettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:switchPadding">16dp</item>
        <item name="android:background">@drawable/bg_row</item>
    </style>
    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="SectionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card_plain</item>
        <item name="android:elevation">1dp</item>
    </style>
    <style name="SectionBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:visibility">gone</item>
        <item name="android:showDividers">middle</item>
        <item name="android:divider">@drawable/divider_inset</item>
    </style>

    <!-- accent colours you can pick in Settings → Look & feel -->
    <style name="Accent_Indigo">
        <item name="nAccent">#FF5B4CF5</item>
        <item name="nAccent2">#FF8B5CF6</item>
        <item name="nAccentSoft">#FFECEAFE</item>
    </style>
    <style name="Accent_Ocean">
        <item name="nAccent">#FF2563EB</item>
        <item name="nAccent2">#FF38BDF8</item>
        <item name="nAccentSoft">#FFE3EDFF</item>
    </style>
    <style name="Accent_Teal">
        <item name="nAccent">#FF0F9D8E</item>
        <item name="nAccent2">#FF22C1A8</item>
        <item name="nAccentSoft">#FFDDF5F1</item>
    </style>
    <style name="Accent_Emerald">
        <item name="nAccent">#FF16A34A</item>
        <item name="nAccent2">#FF65C466</item>
        <item name="nAccentSoft">#FFE2F6E7</item>
    </style>
    <style name="Accent_Sunset">
        <item name="nAccent">#FFEA580C</item>
        <item name="nAccent2">#FFF59E0B</item>
        <item name="nAccentSoft">#FFFFEDE0</item>
    </style>
    <style name="Accent_Rose">
        <item name="nAccent">#FFE11D74</item>
        <item name="nAccent2">#FFF472B6</item>
        <item name="nAccentSoft">#FFFDE6F0</item>
    </style>
    <style name="Accent_Grape">
        <item name="nAccent">#FF9333EA</item>
        <item name="nAccent2">#FFC026D3</item>
        <item name="nAccentSoft">#FFF3E5FF</item>
    </style>
    <style name="Accent_Graphite">
        <item name="nAccent">#FF334155</item>
        <item name="nAccent2">#FF64748B</item>
        <item name="nAccentSoft">#FFE8ECF2</item>
    </style>
    <!-- pure black for AMOLED screens (used only in dark mode) -->
    <style name="Surface_Black">
        <item name="nBg">#FF000000</item>
        <item name="nSurface">#FF0E0E12</item>
        <item name="nSurface2">#FF1A1B21</item>
        <item name="nCardStroke">#FF22232B</item>
        <item name="nDivider">#FF22232B</item>
    </style>
</resources>
