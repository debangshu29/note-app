<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="nAccent">@color/accent</item>
        <item name="nAccent2">@color/accent2</item>
        <item name="nAccentSoft">@color/accent_soft</item>
        <item name="nBg">@color/bg</item>
        <item name="nSurface">@color/surface</item>
        <item name="nSurface2">@color/surface2</item>
        <item name="nCardStroke">@color/card_stroke</item>
        <item name="nDivider">@color/divider</item>
        <item name="android:colorPrimary">?attr/nAccent</item>
        <item name="android:colorPrimaryDark">?attr/nBg</item>
        <item name="android:colorAccent">?attr/nAccent</item>
        <item name="android:colorControlActivated">?attr/nAccent</item>
        <item name="android:colorControlHighlight">#1F7A7F99</item>
        <item name="android:windowBackground">?attr/nBg</item>
        <item name="android:colorBackground">?attr/nBg</item>
        <item name="android:statusBarColor">?attr/nBg</item>
        <item name="android:navigationBarColor">?attr/nBg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:textColorHighlight">#557A6CF7</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:actionModeBackground">@drawable/bg_action_mode</item>
        <item name="android:actionModeCloseDrawable">@drawable/ic_close</item>
        <item name="android:windowAnimationStyle">@style/ScreenAnim</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="DialogTheme" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">?attr/nAccent</item>
        <item name="android:colorControlActivated">?attr/nAccent</item>
        <item name="android:colorBackground">?attr/nSurface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@style/PopAnim</item>
    </style>

    <!-- accent colours you can pick in Settings → Look & feel -->
    <style name="Accent_Indigo">
        <item name="nAccent">#FF8A7DFF</item>
        <item name="nAccent2">#FFB18CFF</item>
        <item name="nAccentSoft">#FF262350</item>
    </style>
    <style name="Accent_Ocean">
        <item name="nAccent">#FF4F8DF7</item>
        <item name="nAccent2">#FF38BDF8</item>
        <item name="nAccentSoft">#FF1B2A4A</item>
    </style>
    <style name="Accent_Teal">
        <item name="nAccent">#FF0EA594</item>
        <item name="nAccent2">#FF2DD4BF</item>
        <item name="nAccentSoft">#FF153A36</item>
    </style>
    <style name="Accent_Emerald">
        <item name="nAccent">#FF22A85A</item>
        <item name="nAccent2">#FF4ADE80</item>
        <item name="nAccentSoft">#FF173A24</item>
    </style>
    <style name="Accent_Sunset">
        <item name="nAccent">#FFF2701F</item>
        <item name="nAccent2">#FFFBBF24</item>
        <item name="nAccentSoft">#FF45281A</item>
    </style>
    <style name="Accent_Rose">
        <item name="nAccent">#FFEC4899</item>
        <item name="nAccent2">#FFF9A8D4</item>
        <item name="nAccentSoft">#FF45182D</item>
    </style>
    <style name="Accent_Grape">
        <item name="nAccent">#FFA855F7</item>
        <item name="nAccent2">#FFE879F9</item>
        <item name="nAccentSoft">#FF351A4A</item>
    </style>
    <style name="Accent_Graphite">
        <item name="nAccent">#FF64748B</item>
        <item name="nAccent2">#FF94A3B8</item>
        <item name="nAccentSoft">#FF262B33</item>
    </style>
    <!-- pure black for AMOLED screens (used only in dark mode) -->
    <style name="Surface_Black">
        <item name="nBg">#FF000000</item>
        <item name="nSurface">#FF0E0E12</item>
        <item name="nSurface2">#FF1A1B21</item>
        <item name="nCardStroke">#FF22232B</item>
        <item name="nDivider">#FF22232B</item>
    </style>
</resources>
