<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout android:id="@+id/w_new" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_btn_accent"
        android:gravity="center" android:orientation="vertical" android:padding="6dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_add" android:tint="#FFFFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:id="@+id/w_new_t" android:maxLines="1" android:text="Note" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_check" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_btn"
        android:gravity="center" android:orientation="vertical" android:padding="6dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_checklist" android:tint="@color/accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:id="@+id/w_check_t" android:maxLines="1" android:text="List" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_voice" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_btn"
        android:gravity="center" android:orientation="vertical" android:padding="6dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_mic" android:tint="@color/accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:id="@+id/w_voice_t" android:maxLines="1" android:text="Voice" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_scan" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_btn"
        android:gravity="center" android:orientation="vertical" android:padding="6dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_scan" android:tint="@color/accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:id="@+id/w_scan_t" android:maxLines="1" android:text="Scan" android:textColor="@color/text" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
