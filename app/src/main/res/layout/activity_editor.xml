<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_pin"
            style="@style/IconButton"
            android:contentDescription="Pin"
            android:src="@drawable/ic_pin" />

        <ImageButton
            android:id="@+id/btn_insert"
            style="@style/IconButton"
            android:contentDescription="Insert: photo, scan, PDF, drawing, sticky note, table, new page"
            android:src="@drawable/ic_add_box" />

        <ImageButton
            android:id="@+id/btn_share"
            style="@style/IconButton"
            android:contentDescription="Share"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/btn_more"
            style="@style/IconButton"
            android:contentDescription="More: find, note style, page settings, page sorter, delete"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- find & replace bar -->
    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/find_query"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="Find in note"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/find_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="52dp"
                android:gravity="center"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/find_prev"
                style="@style/IconButton"
                android:contentDescription="Previous match"
                android:src="@drawable/ic_up" />

            <ImageButton
                android:id="@+id/find_next"
                style="@style/IconButton"
                android:contentDescription="Next match"
                android:src="@drawable/ic_down" />

            <ImageButton
                android:id="@+id/find_close"
                style="@style/IconButton"
                android:contentDescription="Close find"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/find_replace"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="Replace with"
                android:imeOptions="flagNoExtractUi"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/find_replace_one"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Replace"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/find_replace_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tab"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="All"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- title section -->
            <EditText
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Title"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingTop="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/hint"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:id="@+id/chips_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/chips_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="@color/divider" />

            <!-- the note: text, pictures, sticky notes, tables, page breaks -->
            <LinearLayout
                android:id="@+id/blocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:id="@+id/tap_end"
                android:layout_width="match_parent"
                android:layout_height="160dp" />
        </LinearLayout>
    </ScrollView>

    <!-- formatting bar (sits just above the keyboard) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_toolbar"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/format_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </HorizontalScrollView>
</LinearLayout>
