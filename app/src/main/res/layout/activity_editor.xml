<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_pin"
            style="@style/IconButton"
            android:contentDescription="Pin"
            android:src="@drawable/ic_pin" />

        <ImageButton
            android:id="@+id/btn_share"
            style="@style/IconButton"
            android:contentDescription="Share"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/btn_delete"
            style="@style/IconButton"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <EditText
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Title"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:textColor="@color/hint"
                android:textSize="12sp" />

            <com.debangshu.note.SmartEditText
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top|start"
                android:hint="Start writing…\n\nTry: 120+80=\nor: call mom tomorrow at 5pm\nor type [] and a space for a checkbox"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:lineSpacingExtra="5dp"
                android:minHeight="320dp"
                android:paddingBottom="44dp"
                android:textColor="@color/text"
                android:textSize="17sp" />
        </LinearLayout>
    </ScrollView>

    <!-- reminders found in this note -->
    <HorizontalScrollView
        android:id="@+id/chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chips_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- tools + math answer bar (sits just above the keyboard) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/tool_check"
            style="@style/IconButton"
            android:contentDescription="Checklist"
            android:src="@drawable/ic_checklist" />

        <ImageButton
            android:id="@+id/tool_bullet"
            style="@style/IconButton"
            android:contentDescription="Bullet list"
            android:src="@drawable/ic_bullet" />

        <ImageButton
            android:id="@+id/tool_time"
            style="@style/IconButton"
            android:contentDescription="Add a date and time"
            android:src="@drawable/ic_event" />

    </LinearLayout>
</LinearLayout>
