<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nBg"
    android:orientation="vertical">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/CircleButton"
            android:contentDescription="Back"
            android:elevation="1dp"
            android:src="@drawable/ic_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_toolbar"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btn_pin"
                style="@style/IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:contentDescription="Pin"
                android:src="@drawable/ic_pin" />

            <ImageButton
                android:id="@+id/btn_more"
                style="@style/IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:contentDescription="More: find, note style, page settings, page sorter, delete"
                android:src="@drawable/ic_more" />

            <ImageButton
                android:id="@+id/btn_share"
                style="@style/IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:contentDescription="Share"
                android:src="@drawable/ic_share" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_insert"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_accent"
            android:contentDescription="Insert: photo, scan, PDF, drawing, sticky note, table, new page"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add"
            android:tint="@color/on_accent" />
    </LinearLayout>

    <!-- find & replace bar -->
    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_toolbar"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/find_query"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:drawableTint="@color/hint"
                android:hint="Find in note"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/find_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="52dp"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/find_prev"
                style="@style/IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Previous match"
                android:src="@drawable/ic_up" />

            <ImageButton
                android:id="@+id/find_next"
                style="@style/IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Next match"
                android:src="@drawable/ic_down" />

            <ImageButton
                android:id="@+id/find_close"
                style="@style/IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Close find"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/find_replace"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:hint="Replace with"
                android:imeOptions="flagNoExtractUi"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/find_replace_one"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_soft"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Replace"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/find_replace_all"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_fab"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="All"
                android:textColor="@color/on_accent"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <!-- title section -->
            <EditText
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Title"
                android:imeOptions="flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:letterSpacing="-0.01"
                android:paddingTop="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/hint"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:id="@+id/chips_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/chips_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- templates for a new, empty note -->
            <HorizontalScrollView
                android:id="@+id/templates_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/templates_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_handle" />

            <!-- the note: text, pictures, sticky notes, tables, page breaks -->
            <LinearLayout
                android:id="@+id/blocks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:id="@+id/tap_end"
                android:layout_width="match_parent"
                android:layout_height="160dp" />
        </LinearLayout>
    </ScrollView>

    <!-- formatting bar: a floating card just above the keyboard -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_toolbar"
            android:elevation="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/format_bar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </HorizontalScrollView>
    </FrameLayout>
</LinearLayout>
