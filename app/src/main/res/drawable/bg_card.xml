<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1F7A7F99">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/nAccentSoft" />
                    <stroke android:width="2dp" android:color="?attr/nAccent" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/nSurface" />
                    <stroke android:width="1dp" android:color="?attr/nCardStroke" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
